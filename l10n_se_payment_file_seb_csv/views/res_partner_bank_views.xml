<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_bank_form_l10n_se_seb_csv" model="ir.ui.view">
        <field name="name">res.partner.bank.form.l10n_se_seb_csv</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="l10n_se_bank_account.view_partner_bank_form_l10n_se"/>
        <field name="arch" type="xml">
            <field name="l10n_se_account_type" position="after">
                <field name="l10n_se_ocr_required"
                       invisible="l10n_se_account_type not in ('bankgiro', 'plusgiro')"/>
                <field name="l10n_se_ocr_refused"
                       invisible="l10n_se_account_type not in ('bankgiro', 'plusgiro') and not l10n_se_ocr_refused"/>
            </field>
        </field>
    </record>
</odoo>
