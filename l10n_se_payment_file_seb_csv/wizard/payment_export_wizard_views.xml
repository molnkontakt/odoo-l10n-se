<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_se_payment_export_wizard_form" model="ir.ui.view">
        <field name="name">l10n_se.payment.export.wizard.form</field>
        <field name="model">l10n_se.payment.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="journal_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="from_account" invisible="not from_account"/>
                    </group>
                    <group>
                        <field name="date_mode" widget="radio"/>
                        <field name="payment_date" invisible="date_mode != 'fixed'" required="date_mode == 'fixed'"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    No payment is registered: the bills stay unpaid until SEB's bank statement line is reconciled
                    against them. Credit notes are not netted: reconcile them against the bill first.
                </div>
                <div class="alert alert-danger" role="alert" invisible="not blocked_count">
                    <strong>Blocked: these bills cannot be paid in the file.</strong>
                    <field name="blocked_summary" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not has_warnings">
                    <strong>Read the warnings before the file is generated.</strong>
                    <field name="warning_summary" nolabel="1"/>
                    <div class="d-flex align-items-center mt-2">
                        <field name="warnings_acknowledged" nolabel="1" class="oe_inline"/>
                        <label for="warnings_acknowledged" class="fw-bold ms-2"/>
                    </div>
                </div>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0"
                          decoration-danger="status == 'blocked'"
                          decoration-warning="status == 'warning'"
                          decoration-muted="not include and status != 'blocked'">
                        <field name="include" widget="boolean_toggle" readonly="status == 'blocked' and not include" width="60px"/>
                        <field name="move_id" readonly="1" force_save="1"/>
                        <field name="partner_id"/>
                        <field name="move_ref" optional="hide"/>
                        <field name="invoice_date_due" optional="hide"/>
                        <field name="partner_bank_id" options="{'no_create': True}"
                               domain="[('partner_id', 'child_of', partner_id)]"/>
                        <field name="clearing_bank" optional="hide"/>
                        <field name="amount_residual" optional="hide"/>
                        <field name="amount" width="100px"/>
                        <field name="payment_date" width="95px"/>
                        <field name="reference_type" width="125px"/>
                        <field name="reference" width="140px"/>
                        <field name="status" widget="badge" width="80px" decoration-success="status == 'ok'"
                               decoration-warning="status == 'warning'" decoration-danger="status == 'blocked'"/>
                        <field name="problems" optional="hide"/>
                        <field name="warnings" optional="hide"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="bank_from_partner" column_invisible="1" force_save="1"/>
                    </list>
                </field>
                <group>
                    <group>
                        <field name="ready_count"/>
                        <field name="amount_total"/>
                        <field name="blocked_count" invisible="not blocked_count"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="has_warnings" invisible="1"/>
                        <field name="acknowledged_warnings" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate file" class="btn-primary"
                            invisible="not ready_count"/>
                    <button name="action_save_draft" type="object" string="Save as draft" class="btn-secondary"
                            invisible="not ready_count"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
