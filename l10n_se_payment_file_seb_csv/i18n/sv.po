#. module: l10n_se_payment_file_seb_csv
#. odoo-python
#: code:addons/l10n_se_payment_file_seb_csv/wizard/account_payment_register.py:0
msgid ""
"%(bills)s is in SEB payment file %(batch)s, which may still be signed in the"
" internet bank. If SEB has paid it, mark the file as done first; if the "
"payment will not be signed, cancel its line in the file."
