msgstr "Betaldatum saknas."

#. module: l10n_se_payment_file_seb_csv
#. odoo-python
#: code:addons/l10n_se_payment_file_seb_csv/models/l10n_se_payment_export.py:0
msgid "The payment of %(bill)s is done or cancelled and cannot be cancelled."
msgstr "Betalningen av %(bill)s är klar eller avbruten och kan inte avbrytas."

#. module: l10n_se_payment_file_seb_csv
#. odoo-python
#: code:addons/l10n_se_payment_file_seb_csv/models/account_move.py:0
msgid ""
"The payment reference %(reference)s looks like an OCR number but its check "
"digit is wrong, so it is not sent as OCR. If the payee requires OCR, the "
"bank will reject the payment."
msgstr ""
"Betalningsreferensen %(reference)s ser ut som ett OCR-nummer men har fel "
"kontrollsiffra och skickas därför inte som OCR. Om mottagaren kräver OCR "
"avvisar banken betalningen."

#. module: l10n_se_payment_file_seb_csv
#: model:ir.model.constraint,message:l10n_se_payment_file_seb_csv.constraint_l10n_se_payment_export_line_sender_reference_uniq
