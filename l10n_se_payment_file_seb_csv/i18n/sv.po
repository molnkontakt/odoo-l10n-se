#: code:addons/l10n_se_payment_file_seb_csv/models/account_move.py:0
msgid "The message has more than %(max)s characters."
msgstr "Meddelandet har fler än %(max)s tecken."

#. module: l10n_se_payment_file_seb_csv
#. odoo-python
#: code:addons/l10n_se_payment_file_seb_csv/models/account_move.py:0
msgid "The message is empty."
msgstr "Meddelandet är tomt."

#. module: l10n_se_payment_file_seb_csv
#: model:ir.model.fields,help:l10n_se_payment_file_seb_csv.field_l10n_se_payment_export__from_account
msgid "The own account as written in the file's 'Från konto'."
msgstr "Det egna kontot så som det skrivs i filens 'Från konto'."

#. module: l10n_se_payment_file_seb_csv
#. odoo-python
#: code:addons/l10n_se_payment_file_seb_csv/models/account_move.py:0
msgid ""
"The payee requires an OCR reference, but the bill's payment reference "
"%(reference)s is not a valid OCR number."
msgstr ""
"Mottagaren kräver OCR, men fakturans betalningsreferens %(reference)s är "
"inte ett giltigt OCR-nummer."

#. module: l10n_se_payment_file_seb_csv
#. odoo-python
#: code:addons/l10n_se_payment_file_seb_csv/models/account_move.py:0
