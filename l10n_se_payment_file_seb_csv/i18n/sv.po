msgid "Bills paid otherwise"
msgstr "Fakturor betalda på annat sätt"

#. module: l10n_se_payment_file_seb_csv
#: model:ir.model.fields,help:l10n_se_payment_file_seb_csv.field_l10n_se_payment_export_wizard_line__include
msgid ""
"Bills that are not blocked when the export is opened are paid; untick to "
