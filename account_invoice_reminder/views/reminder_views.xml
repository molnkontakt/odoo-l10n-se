<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reminder_list" model="ir.ui.view">
        <field name="name">account.reminder.list</field>
        <field name="model">account.reminder</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="level_id"/>
                <field name="channel"/>
                <field name="move_ids" widget="many2many_tags"/>
                <field name="amount_overdue" sum="Summa"/>
                <field name="fee_amount"/>
                <field name="amount_total"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_reminder_form" model="ir.ui.view">
        <field name="name">account.reminder.form</field>
        <field name="model">account.reminder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Skicka" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print" type="object" string="Skriv ut"/>
                    <button name="action_cancel" type="object" string="Avbryt" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="level_id"/>
                            <field name="channel" readonly="state != 'draft'"/>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="pdf_attachment_id" invisible="not pdf_attachment_id"/>
                        </group>
                        <group>
                            <field name="amount_overdue"/>
                            <field name="fee_amount"/>
                            <field name="fee_move_id" invisible="not fee_move_id"/>
                            <field name="amount_total"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="move_ids">
                        <list>
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_total"/>
                            <field name="amount_residual"/>
                            <field name="payment_state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_reminder_search" model="ir.ui.view">
        <field name="name">account.reminder.search</field>
        <field name="model">account.reminder</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="move_ids"/>
                <filter name="draft" string="Förberedda" domain="[('state', '=', 'draft')]"/>
                <filter name="sent" string="Skickade" domain="[('state', '=', 'sent')]"/>
                <group>
                    <filter name="group_partner" string="Kund" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_level" string="Nivå" context="{'group_by': 'level_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_reminder" model="ir.actions.act_window">
        <field name="name">Betalningspåminnelser</field>
        <field name="res_model">account.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Inga påminnelser ännu</p><p>Skicka från fakturalistan (filter <i>Påminnelse att skicka</i> → Åtgärder → Skicka betalningspåminnelse) eller via knappen Skicka påminnelser.</p></field>
    </record>
    <record id="action_reminder_wizard_menu" model="ir.actions.act_window">
        <field name="name">Skicka påminnelser</field>
        <field name="res_model">account.reminder.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_reminder" name="Betalningspåminnelser" parent="account.menu_finance_receivables"
              action="action_reminder" sequence="25"/>
    <menuitem id="menu_reminder_wizard" name="Skicka påminnelser" parent="account.menu_finance_receivables"
              action="action_reminder_wizard_menu" sequence="26" groups="account.group_account_invoice"/>
</odoo>
