<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_reminder" model="ir.actions.report">
        <field name="name">Betalningspåminnelse</field>
        <field name="model">account.reminder</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_invoice_reminder.report_reminder</field>
        <field name="report_file">account_invoice_reminder.report_reminder</field>
        <field name="print_report_name">'%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_account_reminder"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_reminder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or 'sv_SE')"/>
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-7"/>
                            <div class="col-5">
                                <strong t-field="o.partner_id.name"/>
                                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </div>
                        </div>
                        <h2><span t-field="o.level_id.name"/></h2>
                        <p>
                            <span t-field="o.date"/>
                        </p>
                        <p>
                            Vi saknar betalning för nedanstående faktura<t t-if="len(o.move_ids) > 1">or</t>.
                            <t t-if="o.fee_amount">Enligt lag (1981:739) om ersättning för inkassokostnader tillkommer
                            en avgift på <span t-field="o.fee_amount"/>.</t>
                        </p>
                        <div t-if="o.level_id.note" t-field="o.level_id.note"/>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Faktura</th>
                                    <th>Fakturadatum</th>
                                    <th>Förfallodatum</th>
                                    <th class="text-end">Belopp</th>
                                    <th class="text-end">Kvar att betala</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o._payment_lines()" t-as="m">
                                    <td><span t-field="m.name"/><t t-if="m.reminder_fee_for_id"> (avgift)</t></td>
                                    <td><span t-field="m.invoice_date"/></td>
                                    <td><span t-field="m.invoice_date_due"/></td>
                                    <td class="text-end"><span t-field="m.amount_total"/></td>
                                    <td class="text-end"><span t-field="m.amount_residual"/></td>
                                </tr>
                                <tr t-if="o.fee_amount and not o.fee_move_id">
                                    <td>Påminnelseavgift</td>
                                    <td/>
                                    <td/>
                                    <td class="text-end"><span t-field="o.fee_amount"/></td>
                                    <td class="text-end"><span t-field="o.fee_amount"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-end"><strong>Att betala</strong></td>
                                    <td class="text-end"><strong t-field="o.amount_total"/></td>
                                </tr>
                            </tfoot>
                        </table>
                        <p>
                            Betala till <t t-if="o._bank_account()">bankgiro/konto <strong t-esc="o._bank_account()"/></t>
                            och ange fakturanummer som meddelande. Har du redan betalat kan du bortse från
                            den här påminnelsen. Kontakta oss om något är oklart.
                        </p>
                        <p>
                            <span t-field="o.company_id.name"/><br/>
                            <span t-field="o.company_id.email"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
