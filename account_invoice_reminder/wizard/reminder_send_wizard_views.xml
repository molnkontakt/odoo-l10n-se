<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reminder_send_wizard" model="ir.ui.view">
        <field name="name">account.reminder.send.wizard.form</field>
        <field name="model">account.reminder.send.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p invisible="line_ids">Inga fakturor är aktuella för påminnelse just nu.</p>
                <field name="line_ids" invisible="not line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="partner_id"/>
                        <field name="email"/>
                        <field name="level_id"/>
                        <field name="channel"/>
                        <field name="move_names" string="Fakturor"/>
                        <field name="amount_overdue" sum="Summa"/>
                        <field name="fee_amount" sum="Summa"/>
                        <field name="move_ids" column_invisible="1"/>
                    </list>
                </field>
                <group invisible="not line_ids">
                    <field name="only_prepare"/>
                    <field name="count" invisible="1"/>
                </group>
                <div invisible="not skipped">
                    <b>Hoppas över:</b>
                    <field name="skipped" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_send" type="object" string="Skapa och skicka" class="btn-primary" invisible="not line_ids or only_prepare"/>
                    <button name="action_send" type="object" string="Förbered" class="btn-primary" invisible="not line_ids or not only_prepare"/>
                    <button string="Avbryt" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
