<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Påminnelser och nivåer syns bara i de valda bolagen, som fakturorna de gäller. Utan regeln listades ett annat
         bolags påminnelse, och webbklienten stannade på Åtkomstfel när den läste påminnelsens fakturor (2026-09-29). -->
    <record id="rule_account_reminder_company" model="ir.rule">
        <field name="name">Påminnelse: bolagsregel</field>
        <field name="model_id" ref="model_account_reminder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_account_reminder_level_company" model="ir.rule">
        <field name="name">Påminnelsenivå: bolagsregel</field>
        <field name="model_id" ref="model_account_reminder_level"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
