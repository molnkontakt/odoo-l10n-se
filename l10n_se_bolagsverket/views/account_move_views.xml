<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_se_bolagsverket</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='alerts']" position="after">
                <div class="alert alert-danger mb-0" role="alert" invisible="not l10n_se_bv_warning">
                    <field name="l10n_se_bv_warning"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
