<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_bank_form_l10n_se" model="ir.ui.view">
        <field name="name">res.partner.bank.form.l10n_se</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <field name="acc_number" position="after">
                <field name="l10n_se_account_type"/>
            </field>
        </field>
    </record>
    <record id="view_partner_bank_list_l10n_se" model="ir.ui.view">
        <field name="name">res.partner.bank.list.l10n_se</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_tree"/>
        <field name="arch" type="xml">
            <field name="acc_number" position="after">
                <field name="l10n_se_account_type" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
