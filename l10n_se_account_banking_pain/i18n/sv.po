#. odoo-python
#: code:addons/l10n_se_account_banking_pain/models/account_payment_order.py:0
msgid "Swedish domestic payments must be in SEK: %(partner)s (%(ccy)s)."
msgstr "Svenska inrikes betalningar måste vara i SEK: %(partner)s (%(ccy)s)."

#. module: l10n_se_account_banking_pain
#: model:ir.model.fields,help:l10n_se_account_banking_pain.field_account_payment_mode__l10n_se_bank_profile
msgid ""
"Writes Swedish domestic payments (Bankgiro, Plusgiro, bank account, OCR) the"
" way the bank's ISO 20022 guide requires. Empty = OCA's standard SEPA file."
msgstr ""
"Skriver svenska inrikes betalningar (bankgiro, plusgiro, bankkonto, OCR) "
"enligt bankens ISO 20022-anvisning. Tomt = OCA:s vanliga SEPA-fil."
