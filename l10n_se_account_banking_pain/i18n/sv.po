#. module: l10n_se_account_banking_pain
#: model:ir.model.fields,help:l10n_se_account_banking_pain.field_account_payment_mode__l10n_se_customer_id
msgid ""
"Customer id from the bank's file agreement (SEB: 14 characters). Written as "
"initiating party and debtor with SchmeNm/Cd = BANK."
msgstr ""
"Kund-id enligt bankens filavtal (SEB: 14 tecken). Skrivs som initierande "
"part och betalare med SchmeNm/Cd = BANK."

