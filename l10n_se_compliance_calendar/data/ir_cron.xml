<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_l10n_se_cc_sync" model="ir.cron">
        <field name="name">Compliance Calendar: update dates</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._l10n_se_cc_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:30:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
