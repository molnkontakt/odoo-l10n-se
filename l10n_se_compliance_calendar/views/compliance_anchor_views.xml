<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_se_compliance_anchor_view_list" model="ir.ui.view">
        <field name="name">l10n_se.compliance.anchor.list</field>
        <field name="model">l10n_se.compliance.anchor</field>
        <field name="arch" type="xml">
            <list string="Anchor Dates" editable="bottom">
                <field name="name"/>
                <field name="date"/>
                <field name="year" optional="hide"/>
                <field name="show_in_calendar"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="l10n_se_compliance_anchor_view_search" model="ir.ui.view">
        <field name="name">l10n_se.compliance.anchor.search</field>
        <field name="model">l10n_se.compliance.anchor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="year"/>
                <filter name="group_name" string="Name" context="{'group_by': 'name'}"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_se_compliance_anchor" model="ir.actions.act_window">
        <field name="name">Anchor Dates</field>
        <field name="res_model">l10n_se.compliance.anchor</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an anchor date</p>
            <p>A date that is decided each year, such as the annual meeting. Relative custom rules
                point to it by name.</p>
        </field>
    </record>
</odoo>
