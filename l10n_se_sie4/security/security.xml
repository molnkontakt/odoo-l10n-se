        <field name="name">SIE import: multi-company</field>
        <field name="model_id" ref="model_l10n_se_sie_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_l10n_se_sie_import_check_company" model="ir.rule">
        <field name="name">SIE reconciliation line: multi-company</field>
        <field name="model_id" ref="model_l10n_se_sie_import_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
