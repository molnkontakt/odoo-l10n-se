#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"#FLAGGA 1: the file is marked as already read into a program. Vouchers "
"already in Odoo are skipped anyway."
msgstr ""
"#FLAGGA 1: filen är markerad som redan inläst i ett program. Verifikat som "
"redan finns i Odoo hoppas över ändå."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "#FLAGGA is missing."
msgstr "#FLAGGA saknas."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "#FLAGGA is not the first record."
msgstr "#FLAGGA är inte den första posten."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "#KSUMMA is not a number."
msgstr "#KSUMMA är inte ett tal."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "#KTYP %(account)s: unknown account type '%(value)s'."
msgstr "#KTYP %(account)s: okänd kontotyp '%(value)s'."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "#RAR: the financial year ends before it starts."
msgstr "#RAR: räkenskapsåret slutar innan det börjar."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"#RTRANS is not followed by an identical #TRANS. Only #TRANS lines are "
"booked; check the voucher in the source program."
msgstr ""
"#RTRANS följs inte av en likadan #TRANS. Bara #TRANS-rader bokförs; "
"kontrollera verifikatet i källprogrammet."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "#SIETYP is missing: read as SIE type 1."
msgstr "#SIETYP saknas: läses som SIE typ 1."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(account)s: Odoo %(odoo)s, %(prev)s %(file)s"
msgstr "%(account)s: Odoo %(odoo)s, %(prev)s %(file)s"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/wizard/sie_import_wizard.py:0
msgid "%(count)s SIE files"
msgstr "%(count)s SIE-filer"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid ""
"%(count)s accounts agree with the files, but not every year could be "
"checked: %(years)s."
msgstr ""
"%(count)s konton stämmer med filerna, men alla år kunde inte stämmas av: "
"%(years)s."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(count)s accounts are missing in the chart of accounts: %(accounts)s. "
"Create them yourself or choose 'Create them' under missing accounts."
msgstr ""
"%(count)s konton saknas i kontoplanen: %(accounts)s. Lägg upp dem själv "
"eller välj 'Skapa dem' under saknade konton."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid ""
"%(count)s entries are deleted in the background. Refresh the page to follow "
"the progress."
msgstr ""
"%(count)s verifikat raderas i bakgrunden. Uppdatera sidan för att följa "
"förloppet."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/wizard/sie_import_wizard.py:0
msgid ""
"%(count)s entries are imported in the background. Refresh the page to follow"
" the progress."
msgstr ""
"%(count)s verifikat importeras i bakgrunden. Uppdatera sidan för att följa "
"förloppet."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(count)s entries of %(year)s are dated in a locked period (%(locks)s). Odoo"
" does not allow entries there: change the lock date in the accounting "
"settings or leave the year out."
msgstr ""
"%(count)s verifikat för %(year)s är daterade i en låst period (%(locks)s). "
"Odoo tillåter inga verifikat där: ändra låsdatumet i "
"bokföringsinställningarna eller välj bort året."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(count)s entries will be created."
msgstr "%(count)s verifikat skapas."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid ""
"%(count)s of %(total)s accounts differ from the files. The Reconciliation "
"tab lists them (filter 'Deviations')."
msgstr ""
"%(count)s av %(total)s konton avviker från filerna. De listas under "
"Avstämning (filtret 'Bara avvikelser')."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(count)s vouchers are dated outside the file's financial years (first: "
"%(first)s)."
msgstr ""
"%(count)s verifikat är daterade utanför filens räkenskapsår (första: "
"%(first)s)."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(date)s is before the financial year %(year)s."
msgstr "%(date)s ligger före räkenskapsåret %(year)s."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(entry)s (%(date)s) is in a locked period"
msgstr "%(entry)s (%(date)s) ligger i en låst period"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(entry)s belongs to a bank statement line"
msgstr "%(entry)s hör till en bankrad"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid ""
"%(entry)s does not balance after rounding to %(digits)s decimals (difference"
" %(diff)s)."
msgstr ""
"%(entry)s balanserar inte efter avrundning till %(digits)s decimaler "
"(differens %(diff)s)."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(entry)s has been changed since the import"
msgstr "%(entry)s har ändrats sedan importen"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(entry)s has been reversed"
msgstr "%(entry)s har vänts"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(entry)s is kept by the restrictive audit trail"
msgstr "%(entry)s skyddas av den strikta behandlingshistoriken"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(entry)s is reconciled"
msgstr "%(entry)s är avstämt (matchat)"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(entry)s is secured by a hash"
msgstr "%(entry)s är skyddat med en hash"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(file)s has monthly balances but no vouchers: choose the last day of a "
"month."
msgstr ""
"%(file)s har månadssaldon men inga verifikat: välj sista dagen i en månad."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(file)s has neither vouchers nor monthly balances (#PSALDO): it can only be"
" compared at the end of the year."
msgstr ""
"%(file)s har varken verifikat eller månadssaldon (#PSALDO): den kan bara "
"stämmas av vid årets slut."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(file)s has no closing balances (#UB/#RES) for %(year)s to compare with."
msgstr ""
"%(file)s har inga utgående saldon (#UB/#RES) för %(year)s att jämföra med."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(file)s has no opening balance (#IB 0) for %(year)s."
msgstr "%(file)s har ingen ingående balans (#IB 0) för %(year)s."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(file)s is for organisation number %(orgnr)s (%(name)s), which is not the "
"company's. Check that you import into the right company."
msgstr ""
"%(file)s gäller organisationsnummer %(orgnr)s (%(name)s), som inte är "
"bolagets. Kontrollera att du importerar till rätt bolag."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(file)s is for organisation number %(orgnr)s; the company has no company "
"registry or VAT number to compare it with."
msgstr ""
"%(file)s gäller organisationsnummer %(orgnr)s; bolaget har inget "
"organisations- eller momsregistreringsnummer att jämföra med."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(file)s is in %(currency)s, the company's currency is %(company_currency)s."
msgstr "%(file)s är i %(currency)s, bolagets valuta är %(company_currency)s."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/wizard/sie_import_wizard.py:0
msgid ""
"%(file)s is larger than %(limit)s MB (system parameter "
"l10n_se_sie4.max_file_mb)."
msgstr ""
"%(file)s är större än %(limit)s MB (systemparametern "
"l10n_se_sie4.max_file_mb)."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/wizard/sie_import_wizard.py:0
msgid "%(file)s is not an SIE file (.se, .si or .sie)."
msgstr "%(file)s är inte en SIE-fil (.se, .si eller .sie)."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(file)s, line %(line)s: %(text)s"
msgstr "%(file)s, rad %(line)s: %(text)s"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid ""
"%(file)s: %(count)s vouchers are dated outside the financial year %(year)s "
"and are not imported: %(vouchers)s."
msgstr ""
"%(file)s: %(count)s verifikat är daterade utanför räkenskapsåret %(year)s "
"och importeras inte: %(vouchers)s."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(file)s: %(text)s"
msgstr "%(file)s: %(text)s"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(label)s %(key)s occurs more than once."
msgstr "%(label)s %(key)s förekommer mer än en gång."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(label)s outside a #VER block."
msgstr "%(label)s utanför ett #VER-block."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(label)s: '%(value)s' is not a month (YYYYMM)."
msgstr "%(label)s: '%(value)s' är inte en månad (ÅÅÅÅMM)."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid ""
"%(name)s (%(years)s): %(checked)s accounts, %(deviations)s deviations, "
"%(unchecked)s years not checked."
msgstr ""
"%(name)s (%(years)s): %(checked)s konton, %(deviations)s avvikelser, "
"%(unchecked)s år inte avstämda."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(name)s (new)"
msgstr "%(name)s (ny)"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/wizard/sie_export_wizard.py:0
msgid ""
"%(start)s – %(end)s is not a financial year as the company's settings define"
" it (%(fy_start)s – %(fy_end)s). The file gives it as #RAR 0; check that the"
" previous year (#RAR -1, %(prev_start)s – %(prev_end)s) is right."
msgstr ""
"%(start)s – %(end)s är inte ett räkenskapsår enligt bolagets inställningar "
"(%(fy_start)s – %(fy_end)s). Filen anger perioden som #RAR 0; kontrollera "
"att föregående år (#RAR -1, %(prev_start)s – %(prev_end)s) stämmer."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/wizard/sie_export_wizard.py:0
msgid "%(vouchers)s vouchers, %(accounts)s accounts, %(balances)s balances."
msgstr "%(vouchers)s verifikat, %(accounts)s konton, %(balances)s saldon."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(what)s: '%(value)s' is not a date (YYYYMMDD)."
msgstr "%(what)s: '%(value)s' är inte ett datum (ÅÅÅÅMMDD)."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(what)s: '%(value)s' is not a year number (0, -1, ...)."
msgstr "%(what)s: '%(value)s' är inte ett årsnummer (0, -1, ...)."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(what)s: '%(value)s' is not an account number."
msgstr "%(what)s: '%(value)s' är inte ett kontonummer."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "%(what)s: '%(value)s' is not an amount."
msgstr "%(what)s: '%(value)s' är inte ett belopp."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid ""
"%(year)s, as of %(date)s (%(basis)s): %(checked)s accounts, %(deviations)s "
"deviations."
msgstr ""
"%(year)s, per %(date)s (%(basis)s): %(checked)s konton, %(deviations)s "
"avvikelser."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "%(year)s: not checked. %(note)s"
msgstr "%(year)s: inte avstämt. %(note)s"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "(left out)"
msgstr "(utelämnas)"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "(new journals of the import)"
msgstr "(importens nya journaler)"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "(not created)"
msgstr "(skapas inte)"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "... and %(count)s more"
msgstr "... och %(count)s till"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "A brace { or } that does not belong to a #VER."
msgstr "En klammer { eller } som inte hör till en #VER."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "A dimension or object cannot be read."
msgstr "En dimension eller ett objekt kan inte läsas."

#. module: l10n_se_sie4
#: model:ir.model.fields,help:l10n_se_sie4.field_account_bank_statement_line__l10n_se_sie_fingerprint
#: model:ir.model.fields,help:l10n_se_sie4.field_account_move__l10n_se_sie_fingerprint
msgid ""
"A hash of the entry as the SIE import created it. Undoing the import is "
"refused for an entry that has been changed since."
msgstr ""
"En hash av verifikatet som SIE-importen skapade det. Importen kan inte "
"ångras för ett verifikat som har ändrats sedan dess."

#. module: l10n_se_sie4
#: model:ir.model.fields.selection,name:l10n_se_sie4.selection__l10n_se_sie_import__journal_mode__series
#: model:ir.model.fields.selection,name:l10n_se_sie4.selection__l10n_se_sie_import_wizard__journal_mode__series
msgid "A journal per series"
msgstr "En journal per serie"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "A text has no closing quote."
msgstr "En text saknar avslutande citattecken."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
#: model:ir.model.fields,field_description:l10n_se_sie4.field_l10n_se_sie_import_check__account_code
msgid "Account"
msgstr "Konto"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/wizard/sie_export_wizard.py:0
msgid "Account %(account)s is an off-balance account and is left out."
msgstr ""
"Konto %(account)s är ett konto utanför balansräkningen och tas inte med."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "Account %(code)s"
msgstr "Konto %(code)s"

#. module: l10n_se_sie4
#: model:ir.model.fields,field_description:l10n_se_sie4.field_l10n_se_sie_export_wizard__result_account_id
msgid "Account for Earlier Years' Result"
msgstr "Konto för tidigare års resultat"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "Accounts"
msgstr "Konton"

#. module: l10n_se_sie4
#: model:ir.model.fields,field_description:l10n_se_sie4.field_l10n_se_sie_import__checked_count
#: model:ir.model.fields,field_description:l10n_se_sie4.field_l10n_se_sie_import_year__checked_count
msgid "Accounts Checked"
msgstr "Avstämda konton"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "Accounts missing in Odoo"
msgstr "Konton som saknas i Odoo"

#. module: l10n_se_sie4
#: model:ir.model.fields,help:l10n_se_sie4.field_l10n_se_sie_import_wizard__missing_accounts
msgid ""
"Accounts the files use that are not in the chart of accounts. Created with "
"the name from the file and the type of the neighbouring accounts in your "
"chart (BAS class otherwise)."
msgstr ""
"Konton som filerna använder men som inte finns i kontoplanen. De skapas med "
"namnet från filen och samma typ som närliggande konton i kontoplanen (annars"
" efter BAS-kontoklassen)."

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
msgid "Accounts used without #KONTO: %(accounts)s."
msgstr "Konton som används utan #KONTO: %(accounts)s."

#. module: l10n_se_sie4
#: model:ir.model.fields,field_description:l10n_se_sie4.field_l10n_se_sie_import__message_needaction
msgid "Action Needed"
msgstr "Åtgärd krävs"

#. module: l10n_se_sie4
#: model:ir.model.fields,help:l10n_se_sie4.field_l10n_se_sie_export_wizard__checksum
msgid ""
"Add the optional SIE checksum (CRC-32). Leave it off if the receiving "
"program rejects the file."
msgstr ""
"Lägg till SIE-formatets frivilliga kontrollsumma (CRC-32). Låt bli om det "
"mottagande programmet inte godtar filen."

#. module: l10n_se_sie4
#: model:ir.model.fields.selection,name:l10n_se_sie4.selection__l10n_se_sie_import_year__status__ok
msgid "Agrees"
msgstr "Stämmer"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/l10n_se_sie_import.py:0
msgid "All %(count)s accounts agree with the files."
msgstr "Alla %(count)s konton stämmer med filerna."

#. module: l10n_se_sie4
#: model:ir.model.fields,field_description:l10n_se_sie4.field_l10n_se_sie_export_wizard__all_accounts
msgid "All Active Accounts"
msgstr "Alla aktiva konton"

#. module: l10n_se_sie4
#. odoo-python
#: code:addons/l10n_se_sie4/models/sie_analysis.py:0
#: model:ir.model.fields,field_description:l10n_se_sie4.field_l10n_se_sie_import_year__existing_count
